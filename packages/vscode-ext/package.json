{
  "name": "qlinter-vscode-ext",
  "displayName": "qlinter",
  "version": "0.1.0",
  "description": "VS Code extension that lints and formats Qlik load scripts, powered by @qlinter/core.",
  "license": "MIT",
  "private": true,
  "publisher": "MuellerConstantin",
  "homepage": "https://github.com/MuellerConstantin/qlinter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuellerConstantin/qlinter.git",
    "directory": "packages/vscode-ext"
  },
  "bugs": {
    "url": "https://github.com/MuellerConstantin/qlinter/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "qlik",
    "qvs",
    "qlik sense",
    "load script",
    "formatter"
  ],
  "icon": "images/qlinter-128.png",
  "galleryBanner": {
    "color": "#1a1a1a",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:qlik"
  ],
  "contributes": {
    "languages": [
      {
        "id": "qlik",
        "aliases": [
          "Qlik Script",
          "qlik",
          "qvs"
        ],
        "extensions": [
          ".qvs"
        ],
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        }
      }
    ],
    "commands": [
      {
        "command": "qlinter.showConfig",
        "title": "qlinter: Show active configuration"
      },
      {
        "command": "qlinter.fixAll",
        "title": "qlinter: Fix all auto-fixable problems"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "qlinter.json",
        "url": "./dist/qlinter.schema.json"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "qlinter.fixAll",
          "when": "editorLangId == qlik"
        }
      ]
    },
    "configuration": {
      "title": "qlinter",
      "properties": {
        "qlinter.presets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "recommended"
            ]
          },
          "uniqueItems": true,
          "default": [
            "recommended"
          ],
          "markdownDescription": "Preset(s) to lint with when no `qlinter.json` is found in the workspace. Defaults to `recommended`; set it to an empty array to run no rules at all. A workspace `qlinter.json` always takes precedence over this setting. Individual rules are configured in a `qlinter.json`, not here — see the [rule reference](https://github.com/MuellerConstantin/qlinter/blob/main/packages/core/docs/rules.md)."
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "scratchpad": "node -e \"const fs = require('node:fs'); const fixtures = '../core/tests/rules/fixtures/'; fs.rmSync('scratchpad', { recursive: true, force: true }); fs.mkdirSync('scratchpad'); for (const rule of fs.readdirSync(fixtures)) { fs.copyFileSync(fixtures + rule + '/violation.qvs', 'scratchpad/' + rule + '.qvs'); }\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "npm run build && node -e \"require('node:fs').copyFileSync('../../LICENSE.md', 'LICENSE.md')\" && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@qlinter/core": "file:../core",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "tsdown": "*",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

{
  "name": "@qlinter/chrome-ext",
  "version": "0.2.0",
  "description": "Chrome extension that lints and formats Qlik load scripts inline in the Qlik Sense Data Load Editor, powered by @qlinter/core.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/MuellerConstantin/qlinter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuellerConstantin/qlinter.git",
    "directory": "packages/chrome-ext"
  },
  "scripts": {
    "build": "tsdown && node -e \"require('node:fs').cpSync('public', 'dist', { recursive: true })\"",
    "package": "npm run build && node scripts/zip.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@qlinter/core": "file:../core",
    "@tsdown/css": "^0.22.3",
    "@types/codemirror": "^5.60.17",
    "chrome-types": "^0.1.0",
    "codemirror": "^5.65.18",
    "happy-dom": "^20.11.1",
    "tsdown": "*",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9",
    "yazl": "^2.5.1"
  }
}

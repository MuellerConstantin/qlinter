{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/MuellerConstantin/qlinter",
  "minimum_chrome_version": "93",
  "permissions": ["scripting", "activeTab", "webNavigation", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "images/qlinter-16.png",
    "32": "images/qlinter-32.png",
    "48": "images/qlinter-48.png",
    "128": "images/qlinter-128.png"
  }
}

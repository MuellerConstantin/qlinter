LET vSimple = If(vYear = 2025, 'this year', 'other');
LET vSum = RangeSum(a, b, c);

// The line this call opens on fits, so there is nothing here to separate.
LET vCategory = If(
    vYear >= 2025 and vMonth >= 6 and vDay >= 15,
    'in the late second half of the year 2025',
    'before mid-June 2025'
);

// A single-argument call cannot be meaningfully split, so it is never flagged.
LET vAbsurdlyLongFieldNameThatWouldNormallyMakeThisLineExceedTheConfiguredLimit = Sum(vMonthlyRevenueAcrossEveryRegionThatWeReport);

// A Let-less assignment is bound to one row, so it is never broken up.
vCategory = If(vYear >= 2025 and vMonth >= 6 and vDay >= 15, 'in the late second half of the year 2025', 'before mid-June 2025');

// A call reaching past the line it opens on is broken at the arguments that
// start there; the Match inside one of them is left whole, having never been
// the reason the line was long.
LET vFlag = If(vYear = 2025,
    If(
        Match(vRegionNameAsTheSourceSystemSpellsIt, 'North', 'South'),
        'in scope for this report',
        'out of scope for this report'
    ));

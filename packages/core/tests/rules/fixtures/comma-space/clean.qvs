LET vSum = RangeSum(1, 2, 3);
LET vIf = If(vSum > 0, 'pos', 'neg');
LET vBlock = If(vSum > 0, /* hint */ 'pos', 'neg');

// Comma at end of line: no trailing space required.
LOAD
    A,
    B,
    C
FROM [lib://x/y.qvd];

// Commas inside string literals, bracket identifiers, and Trace bodies are ignored.
LET vStr = 'a,b,c';
LOAD [Order,Items] AS OrderItems
FROM [lib://x/y.qvd];
Trace loading a,b,c;

// A comma closes the operand it follows: no space wedged in before it.
LET vBefore = If(vSum > 0, 'pos', 'neg');
LOAD A, B, C
FROM [lib://x/y.qvd];

// A Set holds its value as written, commas and all.
Set vFieldList = OrderId,Amount;

// The text of a SQL statement goes to the database as written.
SQL SELECT OrderId,Amount FROM dbo.Orders WHERE Amount>0;

// A connector command need not be SQL at all.
SQL {
  "function": "/Vendor/GET_ROWS",
  "values": [ [ "" ], [ "" ] ]
};

// Continuation lines hang one level off their anchor.
[A]:
Load
    Id,
    'Prefix: '
        & Region as Label
From X
Where Id > 0
    And Region <> 'n/a';

// Nesting adds one level per open parenthesis.
Let vFlag = If(Status = 'A',
    If(Region = 'North',
        1,
        2),
    0);

// A line starting with a closing parenthesis dedents back under its anchor.
Let vName = ApplyMap('MapX',
    Region,
    'unknown'
);

// Inline data-block interior is a single token; its indentation is not checked.
[Inline1]:
Load * Inline [
	a, b
	1, 2
];

// A torn-apart Load header is not a continuation — load-indent owns those
// lines at the statement's own indent, so nothing is flagged here.
[Torn]:
Left Join([M])
Load
Distinct
    Id
From X;

// A wrapped prefix argument list, on the other hand, *is* a continuation and
// hangs one level off the line that opens the statement.
[Tree]:
Hierarchy(NodeId, ParentId,
    NodeName)
Load
    NodeId
From X;

// A comment may open a continuation line; the indent is measured from it.
Let vTotal = RangeSum(
    /* first */ 1,
    2
);

// Two parentheses opened on one line still make one level, and the closing
// line lands back under the line that opened them.
Let vDouble = If(Match(
    Region,
    'North'
), 1, 0);

// A continuation carries a level of its own, so what a parenthesis it opens
// contains hangs off that line rather than off the anchor.
Let vTotal = 1
    + Sum(
        Amount
    );

// Nested calls hang one level per line, whatever a line opens: the anchor here
// is a field start rather than a statement start, and the same shape follows.
[Nested]:
Load
    If(Match(Flag, 'True'), 1,
        If(Match(Flag, 'False'), 0,
            If(IsNull(Flag),
                -1,
                Flag
            )
        )
    ) as Flag,
    If(Match(
        Region,
        'North',
        'South'
    ), 1, 0) as Compass,
    If(Match([Region Name], 'North'), 1,
        If(Match([Region Name], 'South'), 0, [Region Name]
        )) as Compass2
From X;

// A ; on a line of its own sits right against the text before it, which runs
// up to the ; and keeps whatever that line holds.
SQL SELECT OrderId
FROM dbo.Orders
;

Trace Loading orders
;

{
  "name": "@qlinter/core",
  "version": "0.1.0-alpha.2",
  "description": "Opinionated linting/formatting utilities for Qlik Script (QVS)",
  "keywords": [
    "qlik",
    "qvs",
    "qlik sense",
    "load script",
    "linter",
    "formatter",
    "parser"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/MuellerConstantin/qlinter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuellerConstantin/qlinter.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE.md', 'LICENSE.md')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "chevrotain": "^13.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsdown": "*",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

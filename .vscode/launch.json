{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-ext",
        "${workspaceFolder}/packages/vscode-ext/scratchpad",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode-ext/dist/**/*.js"],
      "preLaunchTask": "prepare:vscode-ext"
    }
  ]
}
